local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/Fluent.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "Zelynx Hub | JJS",
    SubTitle = "Roblox Player - @bphong0946",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true, -- Hiệu ứng mờ nền kính
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl -- Phím ẩn/hiện menu
})

-- Các Tab chính
local Tabs = {
    Main = Window:AddTab({ Title = "Combat / Main", Icon = "sword" }),
    Visuals = Window:AddTab({ Title = "Visuals & FOV", Icon = "eye" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Options = Fluent.Options

---------------------------------------------------------------------------
-- 1. TAB COMBAT (Auto Counter, Instant Blackhole, Auto Black Flash)
---------------------------------------------------------------------------

-- Biến chức năng
local isCounterActive = false
local isBlackholeActive = false
local isAutoBFActive = false

Tabs.Main:AddParagraph({
    Title = "Trạng thái kỹ năng nhân vật",
    Content = "Bật các tính năng tự động kích hoạt kỹ năng đặc trưng cho từng nhân vật trong Jujutsu Shenanigans."
})

-- Auto Counter (Charles - Eye Catching)
Tabs.Main:AddToggle("AutoCounterToggle", {
    Title = "Auto Counter [Charles]",
    Default = false,
    Description = "Tự động phản đòn khi bị tấn công cận chiến.",
    Callback = function(Value)
        isCounterActive = Value
    end
})

-- Instant Blackhole (Yuki)
Tabs.Main:AddToggle("InstantBlackholeToggle", {
    Title = "Instant Blackhole [Yuki]",
    Default = false,
    Description = "Ép xung phím R liên tục để bung chiêu tức thì.",
    Callback = function(Value)
        isBlackholeActive = Value
    end
})

-- Auto Black Flash (Yuji)
Tabs.Main:AddToggle("AutoBFToggle", {
    Title = "Auto Black Flash [Yuji]",
    Default = false,
    Description = "Tự động chớp thời điểm tung đòn chí mạng.",
    Callback = function(Value)
        isAutoBFActive = Value
    end
})

---------------------------------------------------------------------------
-- 2. TAB VISUALS & FOV (Camlock & FOV Circle)
---------------------------------------------------------------------------

local isAimEnabled = false
local fovRadius = 100

Tabs.Visuals:AddToggle("AimCamlockToggle", {
    Title = "Aim Camlock",
    Default = false,
    Description = "Khóa góc nhìn vào kẻ địch trong vùng FOV.",
    Callback = function(Value)
        isAimEnabled = Value
    end
})

Tabs.Visuals:AddSlider("FOVRadiusSlider", {
    Title = "Bán kính FOV",
    Description = "Chỉnh độ rộng vùng quét mục tiêu",
    Default = 100,
    Min = 40,
    Max = 300,
    Rounding = 0,
    Callback = function(Value)
        fovRadius = Value
    end
})

---------------------------------------------------------------------------
-- LOGIC XỬ LÝ CHẠY NGẦM (BACKEND LOOPS)
---------------------------------------------------------------------------

-- Vòng tròn FOV hiển thị trên màn hình
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Color = Color3.fromRGB(120, 0, 255)
FOVCircle.Transparency = 0.7

local function getClosestPlayerInFOV()
    local closestPlayer = nil
    local shortestDistance = fovRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local rootPart = player.Character.HumanoidRootPart
                local screenPoint, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                
                if onScreen then
                    local mouseLocation = UserInputService:GetMouseLocation()
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Vòng lặp chính xử lý Render và Auto actions
local lastHealth = 100

RunService.RenderStepped:Connect(function()
    local mouseLocation = UserInputService:GetMouseLocation()
    
    -- Cập nhật FOV Circle
    FOVCircle.Visible = isAimEnabled
    FOVCircle.Radius = fovRadius
    FOVCircle.Position = mouseLocation

    -- Xử lý Camlock
    if isAimEnabled then
        local target = getClosestPlayerInFOV()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetPos = target.Character.HumanoidRootPart.Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end
    end

    -- Xử lý Auto Counter (Check sụt máu)
    pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local currentHealth = char.Humanoid.Health
            if currentHealth < lastHealth and isCounterActive then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
            end
            lastHealth = currentHealth
        end
    end)
end)

-- Vòng lặp xử lý tốc độ cao cho Instant Blackhole (R spam) và Auto Black Flash
task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(function()
            if isBlackholeActive then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            end
            if isAutoBFActive then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end)
    end
end)

-- Hoàn tất cài đặt giao diện Fluent
Window:SelectTab(1)
Fluent:Notify({
    Title = "Zelynx Hub",
    Content = "Đã tải thành công giao diện Fluent UI!",
    Duration = 5
})
