-- Zelynx Hub - Camlock with Adjustable FOV
-- Created by @bphong0946

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Biến cấu hình Aim & FOV
local isAimEnabled = false
local fovRadius = 100 -- Bán kính FOV mặc định

-- Tạo giao diện GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ZelynxAimHub"
ScreenGui.Parent = game:CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderColor3 = Color3.fromRGB(120, 0, 255)
MainFrame.Position = UDim2.new(0.5, -150, 0.5, -120)
MainFrame.Size = UDim2.new(0, 300, 0, 240)
MainFrame.Active = true
MainFrame.Draggable = true

-- Header Zelynx
local Header = Instance.new("TextLabel")
Header.Parent = MainFrame
Header.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Header.Size = UDim2.new(1, 0, 0, 35)
Header.Font = Enum.Font.GothamBold
Header.Text = "Zelynx"
Header.TextColor3 = Color3.fromRGB(255, 255, 255)
Header.TextSize = 16

-- Sub-label
local SubLabel = Instance.new("TextLabel")
SubLabel.Parent = Header
SubLabel.BackgroundTransparency = 1
SubLabel.Position = UDim2.new(0, 0, 1, 0)
SubLabel.Size = UDim2.new(1, 0, 0, 20)
SubLabel.Font = Enum.Font.Gotham
SubLabel.Text = "Roblox Player | @bphong0946"
SubLabel.TextColor3 = Color3.fromRGB(170, 170, 170)
SubLabel.TextSize = 11

-- Nút Bật/Tắt Aim (ON/OFF)
local ToggleAimBtn = Instance.new("TextButton")
ToggleAimBtn.Parent = MainFrame
ToggleAimBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
ToggleAimBtn.Position = UDim2.new(0.1, 0, 0.4, 0)
ToggleAimBtn.Size = UDim2.new(0.8, 0, 0, 40)
ToggleAimBtn.Font = Enum.Font.GothamBold
ToggleAimBtn.Text = "Aim Camlock [OFF]"
ToggleAimBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
ToggleAimBtn.TextSize = 14

ToggleAimBtn.MouseButton1Click:Connect(function()
    isAimEnabled = not isAimEnabled
    if isAimEnabled then
        ToggleAimBtn.Text = "Aim Camlock [ON]"
        ToggleAimBtn.TextColor3 = Color3.fromRGB(50, 255, 50)
    else
        ToggleAimBtn.Text = "Aim Camlock [OFF]"
        ToggleAimBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- Nhãn hiển thị giá trị FOV hiện tại
local FovLabel = Instance.new("TextLabel")
FovLabel.Parent = MainFrame
FovLabel.BackgroundTransparency = 1
FovLabel.Position = UDim2.new(0.1, 0, 0.65, 0)
FovLabel.Size = UDim2.new(0.8, 0, 0, 20)
FovLabel.Font = Enum.Font.Gotham
FovLabel.Text = "FOV Radius: " .. fovRadius
FovLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
FovLabel.TextSize = 13

-- Nút tăng FOV (+)
local IncFovBtn = Instance.new("TextButton")
IncFovBtn.Parent = MainFrame
IncFovBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
IncFovBtn.Position = UDim2.new(0.55, 0, 0.8, 0)
IncFovBtn.Size = UDim2.new(0.35, 0, 0, 35)
IncFovBtn.Font = Enum.Font.GothamBold
IncFovBtn.Text = "FOV +"
IncFovBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
IncFovBtn.TextSize = 13

IncFovBtn.MouseButton1Click:Connect(function()
    fovRadius = math.min(300, fovRadius + 20)
    FovLabel.Text = "FOV Radius: " .. fovRadius
end)

-- Nút giảm FOV (-)
local DecFovBtn = Instance.new("TextButton")
DecFovBtn.Parent = MainFrame
DecFovBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
DecFovBtn.Position = UDim2.new(0.1, 0, 0.8, 0)
DecFovBtn.Size = UDim2.new(0.35, 0, 0, 35)
DecFovBtn.Font = Enum.Font.GothamBold
DecFovBtn.Text = "FOV -"
DecFovBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
DecFovBtn.TextSize = 13

DecFovBtn.MouseButton1Click:Connect(function()
    fovRadius = math.max(40, fovRadius - 20)
    FovLabel.Text = "FOV Radius: " .. fovRadius
end)

-- Nút ẩn/hiện Menu bằng phím Insert hoặc bấm trực tiếp
local ToggleMenuBtn = Instance.new("TextButton")
ToggleMenuBtn.Parent = ScreenGui
ToggleMenuBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ToggleMenuBtn.BorderColor3 = Color3.fromRGB(120, 0, 255)
ToggleMenuBtn.Position = UDim2.new(0, 10, 0, 10)
ToggleMenuBtn.Size = UDim2.new(0, 100, 0, 30)
ToggleMenuBtn.Font = Enum.Font.GothamBold
ToggleMenuBtn.Text = "Toggle Menu"
ToggleMenuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleMenuBtn.TextSize = 12

ToggleMenuBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- Vẽ vòng tròn FOV tâm màn hình
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Color = Color3.fromRGB(120, 0, 255)
FOVCircle.Transparency = 0.7

-- Tìm mục tiêu gần nhất nằm trong vùng FOV
local function getClosestPlayerInFOV()
    local closestPlayer = nil
    local shortestDistance = fovRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local rootPart = player.Character.HumanoidRootPart
                local screenPoint, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                
                if onScreen then
                    local mouseLocation = UserInputService:GetMouseLocation()
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Vòng lặp cập nhật FOV Circle và Camlock
RunService.RenderStepped:Connect(function()
    local mouseLocation = UserInputService:GetMouseLocation()
    
    -- Cập nhật thông số hiển thị vòng tròn FOV
    FOVCircle.Visible = isAimEnabled
    FOVCircle.Radius = fovRadius
    FOVCircle.Position = mouseLocation

    -- Xử lý khóa góc nhìn (Camlock) vào mục tiêu khi bật
    if isAimEnabled then
        local target = getClosestPlayerInFOV()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetPos = target.Character.HumanoidRootPart.Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end
    end
end)
